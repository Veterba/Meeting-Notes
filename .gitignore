# virtualenv and build output
.venv/
build/
dist/
__pycache__/
*.pyc

# tool caches
.pytest_cache/
.ruff_cache/

# generated icons (build.sh redraws them)
assets/AppIcon.icns
assets/AppIcon.iconset/

# local settings and user data — never commit these.
# .env.* covers backups like .env.old; .env.example is the one that is tracked.
.env
.env.*
!.env.example
logs/
inbox/
processed/
failed/

# macOS
.DS_Store
