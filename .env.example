# --- folders ------------------------------------------------------------
# Where .vtt/.docx transcripts land: dropped by hand, downloaded from Teams,
# or synced by OneDrive. Pointing this at ~/Downloads is fine.
INBOX_DIR=./inbox
PROCESSED_DIR=./processed
FAILED_DIR=./failed
# A file is picked up once its size has not changed for this many seconds
STABLE_SECONDS=30
POLL_SECONDS=5
# On startup, ignore files that have been sitting in the folder longer than this.
# This is what keeps old documents in ~/Downloads from being swept up.
SCAN_MAX_AGE_HOURS=24

# --- is this actually a transcript? -------------------------------------
# Cheap gate before spending minutes of model time. A file that fails it is
# left exactly where it is — it belongs to someone else.
MIN_TURNS=4
MIN_CHARS=400
# People take turns, so a speaker recurs; section headings in a document do not.
MIN_TURNS_PER_SPEAKER=2.0
# How many detected speakers must be shaped like a person's name, not a sentence.
MIN_NAME_RATIO=0.6

# --- Ollama -------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
# Empty = pick by RAM: >=24 GB -> qwen3:30b-a3b, >=20 GB -> qwen3:14b,
# otherwise qwen3.5:9b
OLLAMA_MODEL=
RAM_FOR_BIG=24
RAM_FOR_MID=20
NUM_CTX=32768
TEMPERATURE=0.2
# Map-reduce kicks in once the transcript is longer than this (token estimate)
MAP_THRESHOLD_TOKENS=6000
CHUNK_TOKENS=5000
OVERLAP_TURNS=2
REQUEST_TIMEOUT=1800

# --- email --------------------------------------------------------------
# outlook_draft = a draft in Outlook for Mac, nothing is sent
# smtp          = send through Gmail SMTP with an app password
MAIL_MODE=outlook_draft
# Comma or semicolon separated. A bare address or "Name <address>", mixed freely.
# Quote a name that contains a comma: "Petrov, Ivan" <ivan@example.com>
RECIPIENTS=team@example.com, Alex Doe <alex.doe@example.com>

# Only needed when MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password-16-chars
SMTP_FROM=you@gmail.com

# --- UI -----------------------------------------------------------------
# Port the "Open editor" menu item uses for Streamlit
UI_PORT=8501
