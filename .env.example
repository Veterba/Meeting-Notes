# --- folders ------------------------------------------------------------
# Where .vtt/.docx transcripts land: dropped by hand, downloaded from Teams,
# or synced by OneDrive. Pointing this at ~/Downloads is fine.
# Relative paths are relative to the data folder
# (~/Library/Application Support/Meeting Notes), never to the current directory.
INBOX_DIR=./inbox
PROCESSED_DIR=./processed
# A file is picked up once its size has not changed for this many seconds
STABLE_SECONDS=30
POLL_SECONDS=5
# On startup, ignore files that have been sitting in the folder longer than this.
# This is what keeps old documents in ~/Downloads from being swept up.
SCAN_MAX_AGE_HOURS=24
# Watch the folder at all. The menu's "Watch the folder" writes this.
WATCH_ENABLED=1

# --- is this actually a transcript? -------------------------------------
# Cheap gate before spending minutes of model time. A file that fails it is
# left exactly where it is — it belongs to someone else.
MIN_TURNS=4
MIN_CHARS=400
# People take turns, so a speaker recurs; section headings in a document do not.
MIN_TURNS_PER_SPEAKER=2.0
# How many detected speakers must be shaped like a person's name, not a sentence.
MIN_NAME_RATIO=0.6

# --- Ollama -------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
NUM_CTX=32768
# If Ollama is not running, a job waits and asks again this often instead of failing
OLLAMA_RETRY_SECONDS=15
TEMPERATURE=0.2
# Map-reduce kicks in once the transcript is longer than this (token estimate)
MAP_THRESHOLD_TOKENS=6000
CHUNK_TOKENS=5000
OVERLAP_TURNS=2
REQUEST_TIMEOUT=1800

# --- recording ------------------------------------------------------------
# The whisper.cpp model for live transcription. Empty = large-v3-turbo (q5, ~570 MB),
# downloaded into the data folder's models/ the first time a call is recorded.
WHISPER_MODEL=
# auto, or a language code such as ru or en. A fixed language is more reliable
# on short phrases than detecting it each time.
WHISPER_LANGUAGE=auto
# 1 = when Teams, Zoom or a browser starts using the microphone, offer to record
# the call (a notification and a banner in the window). It never records by itself.
CALL_DETECT=1

# --- archive --------------------------------------------------------------
# A deleted meeting (its notes and recording) is kept this many days, then
# removed for good: 7, 30 or 90. The window's settings change it.
ARCHIVE_DAYS=30

# --- email --------------------------------------------------------------
# Set the account in the menu: Settings > Mail account…  It writes SMTP_USER
# here and puts the app password in your Keychain, never in this file.
# outlook_draft = a draft in Outlook for Mac, nothing is sent
# smtp          = send through SMTP with an app password
MAIL_MODE=outlook_draft
# Comma or semicolon separated. A bare address or "Name <address>", mixed freely.
# Quote a name that contains a comma: "Petrov, Ivan" <ivan@example.com>
RECIPIENTS=team@example.com, Alex Doe <alex.doe@example.com>

# The address is written here by the menu. The password is in the Keychain
# (service "Meeting Notes", account = this address) and never in this file.
SMTP_USER=
# Only for a provider other than Gmail: a Gmail address implies smtp.gmail.com,
# port 465 and itself as the sender. Not shown in the menu.
#SMTP_HOST=smtp.fastmail.com
#SMTP_PORT=465
#SMTP_FROM=

